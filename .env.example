# Local development only. Compose reads .env; export it before running Maven.
ORACLE_PASSWORD=REPLACE_WITH_GENERATED_ADMIN_PASSWORD
ORACLE_BOOTSTRAP_USER=jdbc_app
ORACLE_BOOTSTRAP_PASSWORD=REPLACE_WITH_BOOTSTRAP_USER_PASSWORD
DB_USERNAME=store_jdbc
DB_PASSWORD=REPLACE_WITH_GENERATED_APP_PASSWORD
DB_PORT=1521
DB_SERVICE=FREEPDB1
DEV_DB_RESET=false
# Login signing key: generate 32 random bytes as Base64; never reuse a DB password.
JWT_SECRET=REPLACE_WITH_BASE64_ENCODED_32_RANDOM_BYTES
JWT_ISSUER=java-jdbc-lab
JWT_TTL_SECONDS=900
# Production is configured separately in the deployment environment:
# PROD_DB_URL=<production Oracle JDBC URL>
# PROD_DB_USERNAME=<production schema user>
# PROD_DB_PASSWORD=<production secret>
# PROD_JWT_SECRET=<separate production Base64 signing key>
# PROD_JWT_ISSUER=<production token issuer>
# PROD_JWT_TTL_SECONDS=900
