# Copy to .env.demo. Use separate generated credentials, never local/prod secrets.
# Passwords: 12-128 alphanumeric characters, starting with a letter.
DEMO_ORACLE_PASSWORD=REPLACE_WITH_GENERATED_ADMIN_PASSWORD
DEMO_DB_PASSWORD=REPLACE_WITH_GENERATED_APP_PASSWORD
# Base64 encoding of at least 32 random bytes (openssl rand -base64 32).
DEMO_JWT_SECRET=REPLACE_WITH_BASE64_RANDOM_KEY
